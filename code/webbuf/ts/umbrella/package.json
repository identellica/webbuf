{
  "name": "webbuf",
  "version": "4.0.1",
  "description": "Rust/WASM optimized buffers for the web, node.js, deno, and bun.",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrohackerlabs/webbuf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "fix": "bun run typecheck && bun run lint && bun run format",
    "build": "bun run build:typescript",
    "build:typescript": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "engines": {
    "node": ">=20.8.0"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "buffer",
    "base64",
    "hex",
    "uint256",
    "int256",
    "uint128",
    "int128",
    "rust",
    "wasm"
  ],
  "author": "Astrohacker",
  "license": "MIT",
  "dependencies": {
    "@webbuf/acb3": "workspace:^",
    "@webbuf/acb3dh": "workspace:^",
    "@webbuf/acb3p256dh": "workspace:^",
    "@webbuf/acs2": "workspace:^",
    "@webbuf/acs2dh": "workspace:^",
    "@webbuf/acs2p256dh": "workspace:^",
    "@webbuf/aescbc": "workspace:^",
    "@webbuf/aesgcm": "workspace:^",
    "@webbuf/aesgcm-mlkem": "workspace:^",
    "@webbuf/aesgcm-p256dh": "workspace:^",
    "@webbuf/aesgcm-p256dh-mlkem": "workspace:^",
    "@webbuf/aesgcm-x25519dh-mlkem": "workspace:^",
    "@webbuf/blake3": "workspace:^",
    "@webbuf/ed25519": "workspace:^",
    "@webbuf/fixedbuf": "workspace:^",
    "@webbuf/mlkem": "workspace:^",
    "@webbuf/mldsa": "workspace:^",
    "@webbuf/numbers": "workspace:^",
    "@webbuf/ripemd160": "workspace:^",
    "@webbuf/rw": "workspace:^",
    "@webbuf/p256": "workspace:^",
    "@webbuf/pbkdf2-sha256": "workspace:^",
    "@webbuf/secp256k1": "workspace:^",
    "@webbuf/sha256": "workspace:^",
    "@webbuf/sig-ed25519-mldsa": "workspace:^",
    "@webbuf/slhdsa": "workspace:^",
    "@webbuf/webbuf": "workspace:^",
    "@webbuf/x25519": "workspace:^"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.13.2",
    "buffer": "^6.0.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}