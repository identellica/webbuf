{
  "name": "@webbuf/sig-ed25519-mldsa",
  "version": "3.8.1",
  "description": "Composite Ed25519 + ML-DSA-65 signatures (OpenPGP-style hybrid: classical + post-quantum) for the web, node.js, deno, and bun.",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrohackerlabs/webbuf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "fix": "bun run typecheck && bun run lint && bun run format",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "engines": {
    "node": ">=20.8.0"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "ed25519",
    "ml-dsa",
    "mldsa",
    "dilithium",
    "composite",
    "hybrid",
    "post-quantum",
    "pqc",
    "fips204",
    "rfc8032",
    "signature"
  ],
  "author": "Astrohacker",
  "license": "MIT",
  "peerDependencies": {
    "@webbuf/ed25519": "workspace:^",
    "@webbuf/fixedbuf": "workspace:^",
    "@webbuf/mldsa": "workspace:^",
    "@webbuf/webbuf": "workspace:^"
  },
  "devDependencies": {
    "@webbuf/ed25519": "workspace:^",
    "@webbuf/fixedbuf": "workspace:^",
    "@webbuf/mldsa": "workspace:^",
    "@webbuf/webbuf": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.13.2",
    "@webbuf/sha256": "workspace:^",
    "buffer": "^6.0.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}