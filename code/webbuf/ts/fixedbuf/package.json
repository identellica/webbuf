{
  "name": "@webbuf/fixedbuf",
  "version": "4.0.1",
  "description": "Fixed-sized buffers optimized with Rust/WASM for the web, node.js, deno, and bun.",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrohackerlabs/webbuf"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "fix": "bun run typecheck && bun run lint && bun run format",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "engines": {
    "node": ">=20.8.0"
  },
  "packageManager": "bun@1.4.0",
  "keywords": [
    "buffer",
    "base64",
    "hex",
    "uint256",
    "int256",
    "uint128",
    "int128",
    "rust",
    "wasm"
  ],
  "author": "Astrohacker",
  "license": "MIT",
  "peerDependencies": {
    "@webbuf/webbuf": "workspace:^"
  },
  "devDependencies": {
    "@webbuf/webbuf": "workspace:^",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.13.2",
    "buffer": "^6.0.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}