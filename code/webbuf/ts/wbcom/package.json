{
  "name": "@webbuf/website",
  "private": true,
  "version": "3.0.27",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 3514",
    "build": "react-router build && nu scripts/finalize.nu",
    "preview": "bun server.ts",
    "check": "react-router typegen && tsc --noEmit",
    "typecheck": "bun run check",
    "test:navigation": "bun test app/lib/docs-navigation.test.ts",
    "extract:api": "tsx scripts/extract-api.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@astrohacker/ui": "workspace:*",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "@react-router/node": "^8",
    "shiki": "^4.0.2",
    "lucide-static": "^1.21.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "isbot": "^5"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "@react-router/dev": "^8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/bun": "latest",
    "@types/node": "^26.3.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "wrangler": "^4.79.0"
  }
}