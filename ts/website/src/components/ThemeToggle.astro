---
// Fixed-width segmented control: light / system / dark. The theme state lives in
// the inline head script (window.__theme); this drives setMode and reflects it.
import Icon from "./Icon.astro";
import sun from "lucide-static/icons/sun.svg?raw";
import monitor from "lucide-static/icons/monitor.svg?raw";
import moon from "lucide-static/icons/moon.svg?raw";

const options = [
  { mode: "light", icon: sun, label: "Light" },
  { mode: "system", icon: monitor, label: "System" },
  { mode: "dark", icon: moon, label: "Dark" },
] as const;
---

<div
  role="group"
  aria-label="Color theme"
  class="inline-flex items-center gap-0.5 rounded-md border border-border bg-surface p-0.5"
>
  {
    options.map(({ mode, icon, label }) => (
      <button
        type="button"
        data-theme-option={mode}
        aria-label={label}
        aria-pressed="false"
        class="inline-flex h-7 w-7 items-center justify-center rounded text-muted transition-colors hover:text-accent"
      >
        <Icon icon={icon} size={16} />
      </button>
    ))
  }
</div>

<script>
  import type { ThemeMode } from "../lib/theme";

  const btns =
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");

  const sync = () => {
    const mode = window.__theme?.getMode() ?? "system";
    btns.forEach((btn) => {
      const active = btn.dataset.themeOption === mode;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("bg-bg", active);
      btn.classList.toggle("text-accent", active);
      btn.classList.toggle("text-muted", !active);
    });
  };

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      window.__theme?.setMode(btn.dataset.themeOption as ThemeMode);
    });
  });
  window.addEventListener("themechange", sync);
  sync();
</script>
